# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# Database (Unified Adapter)
# DB_TYPE: mysql / postgresql / starrocks
# Use a dedicated read-only account. Do not use root.
#   CREATE USER 'readonly_user'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON your_database.* TO 'readonly_user'@'%';
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=your_password
DB_NAME=your_database

# [Legacy] StarRocks specific (if DB_TYPE=starrocks, use DB_* above)
# STARROCKS_HOST=localhost
# STARROCKS_PORT=9030
# STARROCKS_USER=readonly_user
# STARROCKS_PASSWORD=your_password
# STARROCKS_DB=your_database

# Web API authentication (required). /api/chat and other user routes reject
# missing, short (<16), or placeholder keys.
# One key, or several comma-separated caller keys. Each key owns its own sessions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_KEY=replace-with-a-long-random-key
# Admin key for POST /api/scan only. Must be different from WEB_API_KEY.
# Leave the placeholder to keep the scan endpoint disabled.
WEB_ADMIN_API_KEY=replace-with-a-different-long-random-key
# Per-caller request limit (chat, skills) and admin scan limit.
WEB_RATE_LIMIT_PER_MINUTE=30
WEB_ADMIN_RATE_LIMIT_PER_MINUTE=5
WEB_AUTH_FAILURE_LIMIT_PER_MINUTE=10
# 钉钉等机器人通道：每个外部用户每分钟最多多少条消息。
BOT_RATE_LIMIT_PER_MINUTE=30

# Web 密钥到数据角色。左边必须是 WEB_API_KEY 里的某一把密钥，右边是 role_definitions.role_id。
# 没有映射的密钥可以登录接口，但不能查询。多项用逗号分隔。
# WEB_API_KEY_ROLES=the-same-long-key=analyst
WEB_API_KEY_ROLES=

# 查询复用。相似度达到阈值、状态为 verified、且当前角色能读全部表才命中。
QUERY_CACHE_SIMILARITY=0.85
QUERY_CACHE_SUCCESS_TO_VERIFY=3
QUERY_CACHE_DOWN_THRESHOLD=2
# auto：装了 sentence-transformers 就用中文模型，否则退回确定性哈希。
# hash：始终用哈希，不下载模型。sentence-transformers：必须用模型。
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Bind address for `python web_server.py`. Docker publishes 127.0.0.1:8080 separately.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080

# Pre-SQL hook. true (default) blocks tables that are not in the data dictionary.
# SELECT *, extra JOINs, and LIKE '%...%' are warnings and still run.
# Set false to warn on unknown tables instead of blocking them.
# /api/scan reloads the table whitelist without a restart.
SQL_HOOK_STRICT_MODE=true

# PostgreSQL (Experience Store)
# docker-compose requires PG_PASSWORD: 12+ characters, not a placeholder.
# An existing volume does not pick up a changed password automatically.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=agent_experience
PG_USER=agent_user
PG_PASSWORD=

# DingTalk Bot (replaceable with Slack/Teams)
DINGTALK_BOT_APP_KEY=your_app_key
DINGTALK_BOT_APP_SECRET=your_app_secret

# Feishu / Lark bot, long connection (WebSocket). Private chats only.
# Create an enterprise app, enable the bot, then paste App ID and App Secret.
# Leave blank to keep the Feishu process from starting.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Background analysis workers for the Feishu process. Default 4.
FEISHU_WORKERS=4

# Optional
LOG_DIR=./logs
CHROMA_DIR=./chroma_db
