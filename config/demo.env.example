# 演示专用。不要把这些值抄进生产 .env，也不要让生产进程读取本文件。
# 启动：make demo
DEMO_MODE=1
DEEPSEEK_API_KEY=sk-demo-not-a-real-key
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=skadi_demo
DB_PASSWORD=demo-only-password-not-for-production
DB_NAME=skadi_demo
DATA_DICTIONARY_PATH=/app/config/data_dictionary.demo.yml
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=agent_experience
PG_USER=agent_user
PG_PASSWORD=demo-only-pg-password-not-for-production-12
WEB_API_KEY=demo-user-key-0123456789abcdef
WEB_ADMIN_API_KEY=demo-admin-key-0123456789abc
WEB_API_KEY_ROLES=demo-user-key-0123456789abcdef=demo_analyst
WEB_BIND_HOST=0.0.0.0
EMBEDDING_BACKEND=hash
REPORT_SCHEDULER=off
REPORT_STORE_DIR=/app/data/reports
